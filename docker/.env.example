# OpenShell Claude Code Environment Configuration
#
# Copy this file to .env in docker/ and customize values as needed.
# Podman Compose will automatically load these values.

# Gateway port (default: 8080)
OPENSHELL_PORT=8080

# Health check port (default: 8081)
OPENSHELL_HEALTH_PORT=8081

# Gateway container image tag (default: latest)
IMAGE_TAG=latest

# Optional: Specify a custom Claude Code image
# Uncomment and set to use a custom image instead of the one built locally
# CLAUDE_CODE_IMAGE=myregistry.com/openshell-claude-code:v1.0.0

# Optional: Anthropic API key for provider setup
# ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# Optional: OpenRouter API key for provider setup
# OPENROUTER_API_KEY=YOUR_KEY_HERE

# Optional: Logging level for the gateway
# Options: trace, debug, info, warn, error
# RUST_LOG=openshell=info

# Optional: Database URL (default: SQLite in /var/lib/openshell)
# For production, use PostgreSQL:
# OPENSHELL_DB_URL=postgresql://user:password@localhost/openshell

# Optional: Gateway name (for telemetry and identification)
# OPENSHELL_GATEWAY_NAME=openshell-claude-code

# Optional: Enable telemetry (default: true)
# Set to 'false' to disable anonymous telemetry
# OPENSHELL_TELEMETRY_ENABLED=true

# Optional: OpenTelemetry collector endpoint
# OPENSHELL_OTLP_ENDPOINT=http://localhost:4317
